# Supabase service role credentials are server-only. Never add these to frontend env vars.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini is used by the backend only (Stage 5).
GEMINI_API_KEY=your-google-gemini-api-key

# Optional approval delivery (configure at least one provider for approvals).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required to hash approval OTPs; use at least 32 random characters.
OTP_SECRET=replace-with-at-least-32-random-characters

# Local backend port.
PORT=3001

# Optional backend URL used by the standalone MCP stdio process.
CYBERSENTINEL_API_URL=http://localhost:3001