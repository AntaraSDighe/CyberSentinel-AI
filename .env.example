# Public key used for Supabase Auth; the service-role key remains backend-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini is backend-only. The AI feature remains unavailable until configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local demo settings. npm run dev sets NODE_ENV=development; production
# startup never grants demo scopes or enables terminal OTP delivery.
DEMO_CONSENT_SETUP=true
# Development-only unauthenticated demo identity; production never enables it.
DEMO_AUTH=true
# Development only: OTPs are printed to the backend terminal, never the API.
DEV_OTP_DELIVERY=true

# Production approval delivery: configure either the complete SMTP group OR
# both Telegram values below. SMTP_PORT and SMTP_SECURE are optional settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required to hash OTPs and pseudonymous rate-limit keys; generate at least 32 random characters with
# `openssl rand -hex 32`.
OTP_SECRET=

# Local backend port.
PORT=3001

# Optional exact HTTPS origin for a separate frontend; same-origin Render hosting needs no CORS value.
CORS_ORIGIN=

# Public Supabase Auth configuration used by the production frontend build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional backend URL used by the standalone MCP stdio process.
CYBERSENTINEL_API_URL=http://localhost:3001
# Supabase Auth access token for the MCP user's account; never commit it.
CYBERSENTINEL_API_TOKEN=