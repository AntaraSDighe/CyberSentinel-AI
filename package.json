{
  "name": "cybersentinel-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "mcp": "npm run mcp --workspace backend",
    "test": "npm test --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}